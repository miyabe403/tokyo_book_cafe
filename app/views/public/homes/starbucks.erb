<!-- app/views/public/homes/starbucks.erb -->
<h1>スターバックス 商品一覧</h1>

<% if @product_data.present? %>
  <!-- Flexboxコンテナを設定 -->
  <div style="display: flex; flex-wrap: wrap; gap: 20px;">
    <% @product_data.each do |product| %>
      <!-- 1つの商品情報の表示 -->
      <div style="flex: 1 1 calc(25% - 20px); box-sizing: border-box; text-align: center; padding: 10px; border: 1px solid #ccc; border-radius: 8px; background-color: #f9f9f9;">
        
        <!-- 商品名: 長すぎる場合は省略 -->
        <h2 style="font-size: 16px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; width: 100%; margin-bottom: 10px;">
          <%= product['product_name'] %>
        </h2>
        
        <!-- キャッチコピーがない場合でも表示を調整 -->
        <% if product['catchcopy'].present? %>
          <p style="font-size: 14px; color: #555; margin-bottom: 10px;"><%= product['catchcopy'] %></p>
        <% else %>
          <p style="font-size: 14px; color: #aaa; margin-bottom: 10px;">キャッチコピーはありません</p>
        <% end %>
        
        <!-- 価格 -->
        <p style="font-size: 16px; font-weight: bold; margin-bottom: 10px;"><%= product['price'] %>円</p>
        
        <!-- 絶対URLに変換して画像を表示 -->
        <img src="<%= product['image1'].start_with?('http') ? product['image1'] : 'https://product.starbucks.co.jp' + product['image1'] %>" alt="<%= product['product_name'] %>" style="width: 100%; height: auto; max-width: 200px; margin-bottom: 10px;">
      </div>
    <% end %>
  </div>
<% else %>
  <p>商品情報が読み込めませんでした。</p>
<% end %>

